	local tile = tileTemplate:Clone()
	tile.LayoutOrder = order
	tile.Caption.Text = name
	tile.Parent = stats
	local value = Instance.new("NumberValue")
	value.Parent = tile
	value.Changed:Connect(function(n)
		tile.Value.Text = tostring(math.round(n))
	end)
	tiles[name] = value
end

