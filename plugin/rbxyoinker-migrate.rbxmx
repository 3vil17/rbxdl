local function setStatus(message, color)
	note.Visible = message ~= nil and message ~= ""
	noteText.Text = message or ""
	local icon = icons.radio
	if color == green then
		note.BackgroundColor3 = green
		note.BackgroundTransparency = 0.9
		noteText.TextColor3 = okText
		icon = icons.check
	elseif color == red then
		note.BackgroundColor3 = Color3.fromRGB(236, 59, 71)
		note.BackgroundTransparency = 0.88
		noteText.TextColor3 = red
		icon = icons.alert
	else
		note.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		note.BackgroundTransparency = 0.95
		noteText.TextColor3 = text
	end
	noteIcon.Image = icon[1]
	noteIcon.ImageRectOffset = Vector2.new(icon[2], icon[3])
	noteIcon.ImageColor3 = noteText.TextColor3
end

local function setPill(label, color)
	pillText.Text = label
	dot.BackgroundColor3 = color
end

local function showView()
	local paired = token ~= ""
	connectCard.Visible = not paired
	placeCard.Visible = paired
	disconnectButton.Visible = paired
	applyButton.Visible = paired and next(lastMap) ~= nil
	if paired then
		setPill("Connected", green)
	else
		setPill("Not connected", Color3.fromRGB(110, 110, 110))
		progressCard.Visible = false
		fill.Size = UDim2.fromScale(0, 1)
	end
end

local function forget()
	token = ""
	plugin:SetSetting("rbxyoinkerToken", "")
	polling = false
	showView()
end

local function call(method, path, body)
	local ok, res = pcall(HttpService.RequestAsync, HttpService, {
		Url = serverUrl .. path,
		Method = method,
		Headers = { ["Content-Type"] = "application/json", ["X-Yoinker-Token"] = token },
		Body = body and HttpService:JSONEncode(body) or nil,
	})
	if not ok then
		setPill("App not running", red)
		setStatus("Can't reach rbxyoinker. Start the app and try again.", red)
		return nil
	end
	local decodedOk, decoded = pcall(HttpService.JSONDecode, HttpService, res.Body)
	if res.StatusCode == 401 then
		forget()
		setStatus("rbxyoinker forgot this Studio. Get a new code in the Migrate tab.", red)
		return nil
	end
	if not decodedOk or not decoded.ok then
		setStatus(decodedOk and tostring(decoded.error) or "rbxyoinker sent back something odd.", red)
		return nil
	end
	if token ~= "" then
		setPill("Connected", green)
	end
	return decoded.data
end

local function scan(config)
	refs = {}
	scriptRefs = {}
	local ids = {}
	local seen = {}
	local picked = {}
	local listed = {}
	for _, name in config.services do
		picked[name] = true
	end
	for _, name in config.all do
		listed[name] = true
	end
	local everything = {}
	for _, service in game:GetChildren() do
		local include
		if service.ClassName == "CoreGui" then
			include = not config.skip_coregui
		elseif listed[service.ClassName] then
			include = picked[service.ClassName]
		else
			include = picked.Other
		end
		if include then
			local ok, list = pcall(service.GetDescendants, service)
			if ok then
				table.move(list, 1, #list, #everything + 1, everything)
			end
		end
	end
	for _, inst in everything do
		local props = watched[inst.ClassName]
		if props then
			for _, prop in props do
				local ok, value = pcall(function()
					return inst[prop]
				end)
				local digits = ok and typeof(value) == "string" and string.match(value, "%d%d%d+")
				if digits then
					table.insert(refs, { instance = inst, prop = prop, id = digits })
					if not seen[digits] then
						seen[digits] = true
						table.insert(ids, digits)
					end
				end
			end
		elseif inst:IsA("LuaSourceContainer") then
			local ok, source = pcall(function()
				return inst.Source
			end)
			if ok and typeof(source) == "string" then
				local found = false
				for _, pattern in { "rbxassetid://(%d+)", "asset/%?id=(%d+)" } do
					for digits in string.gmatch(source, pattern) do
						found = true
						if not seen[digits] then
							seen[digits] = true
							table.insert(ids, digits)
						end
					end
				end
				if found then
					table.insert(scriptRefs, inst)
				end
			end
		end
	end
	return ids
end

local function applySwaps()
	local swapped = 0
	local waiting = 0
	local meshParts = {}
	local recording = ChangeHistoryService:TryBeginRecording("rbxyoinker migrate")
	for _, ref in refs do
		local newId = lastMap[ref.id]
		if newId and ref.instance.Parent then
			local content = "rbxassetid://" .. newId
			if ref.instance:IsA("MeshPart") and ref.prop == "MeshId" then
				local source = meshParts[newId]
				if not source then
					local ok, part = pcall(AssetService.CreateMeshPartAsync, AssetService, content)
					if ok then
						source = part
						meshParts[newId] = part
					end
				end
				if source and pcall(ref.instance.ApplyMesh, ref.instance, source) then
					ref.id = newId
					swapped += 1
				else
					waiting += 1
				end
			elseif pcall(function()
				ref.instance[ref.prop] = content
			end) then
				ref.id = newId
				swapped += 1
			end
		end
	end
	for _, container in scriptRefs do
		if container.Parent then
			pcall(ScriptEditorService.UpdateSourceAsync, ScriptEditorService, container, function(source)
				for oldId, newId in lastMap do
					local first, firstCount = string.gsub(source, "rbxassetid://" .. oldId .. "%f[%D]", "rbxassetid://" .. newId)
					local second, secondCount = string.gsub(first, "asset/%?id=" .. oldId .. "%f[%D]", "asset/?id=" .. newId)
					source = second
					swapped += firstCount + secondCount
				end
				return source
			end)
		end
	end
	if recording then
		ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Commit)
	end
	if waiting > 0 then
		setStatus(swapped .. " ids swapped. " .. waiting .. " meshes aren't processed by Roblox yet, click Swap ids again in a minute.", bright)
	else
		setStatus(swapped .. " ids swapped. Ctrl+Z undoes it.", green)
	end
	applyButton.Visible = true
end

local function poll()
	if polling or token == "" then
		return
	end
	polling = true
	task.spawn(function()
		while polling and widget.Enabled and token ~= "" do
			local job = call("GET", "/api/studio/job")
			if not job then
				break
			end
			local total = 0
			local moved = 0
			local failed = 0
			for _, item in job.items do
				if item.state ~= "found" then
					total += 1
					if item.state == "ok" then
						moved += 1
					elseif item.state == "error" then
						failed += 1
					end
				end
			end
			local done = moved + failed
			progressCard.Visible = total > 0
			fill.Size = UDim2.fromScale(total > 0 and done / total or 0, 1)
			counts.Text = string.format('<font color="#E0E0E0"><b>%d</b></font> / %d done    <font color="#E0E0E0"><b>%d</b></font> moved    <font color="#E0E0E0"><b>%d</b></font> failed', done, total, moved, failed)
			if job.running then
				setStatus("Moving assets, keep Studio open.")
			elseif seenRun >= 0 and job.run_id ~= seenRun and total > 0 then
				seenRun = job.run_id
				lastMap = {}
				for _, item in job.items do
					if item.new_id then
						lastMap[tostring(item.id)] = tostring(item.new_id)
					end
				end
				if job.mode == "swap" then
					applySwaps()
				else
					setStatus("Done. Copy the mapping from the app.", green)
				end
			end
			task.wait(2)
		end
		polling = false
	end)
end

local function connect()
	local code = string.gsub(codeBox.Text, "%D", "")
	if #code ~= 6 then
		setStatus("The code is 6 digits.", red)
		return
	end
	local paired = call("POST", "/api/studio/pair", { code = code })
	if not paired then
		return
	end
	token = paired.token
	plugin:SetSetting("rbxyoinkerToken", token)
	codeBox.Text = ""
	showView()
	setStatus("Connected. Scan the place when you're ready.", green)
	poll()
end

local function scanAndSend()
	setStatus("Scanning ...")
	local config = call("GET", "/api/studio/scan")
	if not config then
		return
	end
	local ids = scan(config)
	if #ids == 0 then
		setStatus("No asset ids found in the parts of the place you picked to scan.")
		return
	end
	local sent = call("POST", "/api/studio/submit", { place = game.Name, place_id = game.PlaceId, ids = ids })
	if not sent then
		return
	end
	seenRun = sent.run_id
	lastMap = {}
	applyButton.Visible = false
	fill.Size = UDim2.fromScale(0, 1)
	setStatus("Sent " .. sent.count .. " ids. Pick where they go in rbxyoinker's Migrate tab.", bright)
	poll()
end

connectButton.MouseButton1Click:Connect(connect)
scanButton.MouseButton1Click:Connect(scanAndSend)

codeBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		connect()
	end
end)

applyButton.MouseButton1Click:Connect(applySwaps)

disconnectButton.MouseButton1Click:Connect(function()
	forget()
	setStatus("Disconnected.")
end)

toggle.Click:Connect(function()
	widget.Enabled = not widget.Enabled
end)

widget:GetPropertyChangedSignal("Enabled"):Connect(function()
	if widget.Enabled then
		poll()
	end
end)

showView()
setStatus(token == "" and "The rbxyoinker app has to be running." or "")
if widget.Enabled then
	poll()
end
]]></ProtectedString></Properties></Item></roblox>
